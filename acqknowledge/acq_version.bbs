; Filtering and rescaling draft — not runnable until placeholders are replaced.
; This draft deletes raw/intermediate waves. For comparison data, use README.md.
; Native command evidence and open questions: command_verification.md.

Lessons
OnOpenFile

; Example MVCs only: replace with participant values in mV.
; Reserve M for ZM and N for CS; never reuse them for channel IDs.
M = 0.101      ; M: Zygomaticus Major (ZM) MVC value (mV)
N = 0.083      ; N: Corrugator Supercilii (CS) MVC value (mV)

; 1. Select the open graph.
GetTopGraph G$
GetStringLength G$, z
if z = 0
    Prompt "No graph open! Please open an AcqKnowledge file first.", "OK"
    Halt
endif
Select Window G$

; 2. Keep raw ZM 3 and CS 4. Confirm display-to-script IDs and scan range.
; Video observation: raw channels retain their numbers after cleanup.
Get Channel Enable 3, H
Get Channel Enable 4, J
if H < 1
    Prompt "Original raw ZM channel 3 is missing.", "OK"
    Halt
endif
if J < 1
    Prompt "Original raw CS channel 4 is missing.", "OK"
    Halt
endif
if M <= 0
    Prompt "ZM MVC must be positive and in the signal's units.", "OK"
    Halt
endif
if N <= 0
    Prompt "CS MVC must be positive and in the signal's units.", "OK"
    Halt
endif

Set Channel 3, On
Set Channel 4, On

i = 59
ChannelCleanupLoop:
    if i = 3
        goto ChannelCleanupNext
    endif
    if i = 4
        goto ChannelCleanupNext
    endif
    Get Channel Enable i, e
    if e > 0
        Select Wave i
        Edit Remove
    endif
ChannelCleanupNext:
    i = i - 1
    if i >= 0
        goto ChannelCleanupLoop
    endif

; 3. ZM: FIR -> comb -> RMS, each creating a new wave and returning its ID.
; FIR: 28–500 Hz, Blackman -61 dB, optimized coefficient count.
; Comb: 60 Hz, Q=5, all harmonics up to Nyquist.
; RMS: average over 1000 samples, RMS selected, Remove baseline unchecked.
; Apply every transform to the entire wave.
Select Wave 3
Edit SelectAll
[PLACEHOLDER_TransformFIR] BandPass, 28, 500, Blackman61, d
Select Wave d
Edit SelectAll
[PLACEHOLDER_TransformComb] 60.0, 5.0, f
Select Wave f
Edit SelectAll
[PLACEHOLDER_TransformIntegrateRMS] 1000, g

; Remove ZM raw/intermediates; preserve raw CS 4 and ZM RMS g.
Select Wave f
Edit Remove
Select Wave d
Edit Remove
Select Wave 3
Edit Remove

; 4. Repeat the same settings for CS; preserve completed ZM RMS g.
Select Wave 4
Edit SelectAll
[PLACEHOLDER_TransformFIR] BandPass, 28, 500, Blackman61, a
Select Wave a
Edit SelectAll
[PLACEHOLDER_TransformComb] 60.0, 5.0, b
Select Wave b
Edit SelectAll
[PLACEHOLDER_TransformIntegrateRMS] 1000, c

; Remove CS raw/intermediates; preserve CS RMS c and ZM RMS g.
Select Wave b
Edit Remove
Select Wave a
Edit Remove
Select Wave 4
Edit Remove

; 5. Label both RMS results. Their units remain mV.
Set Channel c, Label, "CS RMS"
Set Channel g, Label, "ZM RMS"

; 6. Create percentage outputs: CS first, then ZM; divide by MVC/100.
Select Wave c
Edit SelectAll
P = N / 100.0
[PLACEHOLDER_WaveformMath] Divide, Constant, P, u

Select Wave g
Edit SelectAll
Q = M / 100.0
[PLACEHOLDER_WaveformMath] Divide, Constant, Q, v

; 7. Only the new percentage waveforms receive % units.
[PLACEHOLDER_SetUnits] u, "%"
Set Channel u, Label, "CS percent MVC"
[PLACEHOLDER_SetUnits] v, "%"
Set Channel v, Label, "ZM percent MVC"

; 8. Save a NEW file with four outputs: CS %, ZM %, CS RMS, ZM RMS.
; Intended displayed numbers: 1 (u), 2 (v), 3 (c), 5 (g).
; Confirm actual IDs in the software; do not overwrite the RMS sources.
[PLACEHOLDER_SaveAsSubfolder] "filter_edit files", "_filter.acq"
Prompt "Finished filtering and rescaling!", "OK"
End
